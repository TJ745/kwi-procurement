generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth core tables)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // Built-in system role: "super_admin" (the .env-managed account, full
  // access) or "user" (access defined by `customRole`). Never accepted from
  // client input (see lib/auth.ts).
  role               String    @default("user")
  roleId             String?
  customRole         Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  // Deactivated users cannot sign in; records are kept for history.
  active             Boolean   @default(true)
  // Set when an administrator assigns a temporary password.
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  sessions           Session[]
  accounts           Account[]
  materialRequests   MaterialRequest[]
  purchaseOrders     PurchaseOrder[]
  paymentRequests    PaymentRequest[]
  goodsReceipts      GoodsReceipt[]
  notifications      Notification[]

  @@index([roleId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Access control and settings
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique @db.Citext
  description String?
  // Permission keys such as "projects:view" (see lib/permissions.ts).
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("role")
}

// Single row (id = 1) holding system-wide settings.
model AppSettings {
  id                   Int      @id @default(1)
  companyName          String?
  companyAddress       String?
  companyVat           String?
  companyCr            String?
  companyPhone         String?
  companyEmail         String?
  companyLogo          Bytes?
  companyLogoType      String?
  // Image printed at the bottom of every printed page and PDF.
  printFooter          Bytes?
  printFooterType      String?
  currency             String   @default("USD")
  timeZone             String   @default("UTC")
  dateFormat           String   @default("d MMM yyyy")
  sessionDurationHours Int      @default(168)
  minPasswordLength    Int      @default(12)
  // Purchase order defaults.
  defaultVatRate       Decimal  @default(0) @db.Decimal(5, 2)
  purchaseOrderTerms   String?
  updatedAt            DateTime @updatedAt

  @@map("app_settings")
}

// Numbering configuration and counter per document type.
model DocumentSequence {
  type        String   @id
  prefix      String
  includeYear Boolean  @default(true)
  resetYearly Boolean  @default(true)
  padding     Int      @default(4)
  nextNumber  Int      @default(1)
  // Year the counter last started from 1 (used when resetYearly is on).
  counterYear Int?
  updatedAt   DateTime @updatedAt

  @@map("document_sequence")
}

// In-app notifications shown in the header bell.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // e.g. "material_request.created" (see lib/notifications.ts).
  type      String
  title     String
  body      String
  // In-app path the notification opens, e.g. /material-requests/abc.
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Master data
// Citext columns make uniqueness case-insensitive (requires the citext
// extension, created in migration 20261101120000_master_data_constraints).
// ---------------------------------------------------------------------------

model Project {
  id        String   @id @default(cuid())
  code      String   @unique @db.Citext
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  materialRequests MaterialRequest[]
  purchaseOrders   PurchaseOrder[]
  paymentRequests  PaymentRequest[]
  goodsReceipts    GoodsReceipt[]

  @@map("project")
}

enum SupplierPaymentTerm {
  CASH
  CREDIT
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  // Stored normalised (uppercase, no spaces); unique when provided.
  vat           String?  @unique
  cr            String?
  iban          String?
  address       String?
  contactName   String?
  contactEmail  String?
  contactNumber String?
  email         String?
  telephone     String?
  // Cash or credit supplier; credit days only apply to credit suppliers.
  paymentTerm   SupplierPaymentTerm @default(CASH)
  creditDays    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  materialRequests MaterialRequest[]
  purchaseOrders   PurchaseOrder[]
  paymentRequests  PaymentRequest[]

  @@map("supplier")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique @db.Citext
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  materialRequests MaterialRequest[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  goodsReceiptLines GoodsReceiptLine[]

  @@map("department")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique @db.Citext
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  materialRequests MaterialRequest[]
  purchaseOrders   PurchaseOrder[]

  @@map("category")
}

// ---------------------------------------------------------------------------
// Procurement workflows
// ---------------------------------------------------------------------------

enum MaterialRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model MaterialRequest {
  id           String                @id @default(cuid())
  // Assigned from Settings > Document numbering when the request is created.
  number       String                @unique @db.Citext
  requestDate  DateTime              @db.Date
  status       MaterialRequestStatus @default(DRAFT)
  projectId    String
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // Shown as "Requested by".
  departmentId String
  department   Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  categoryId   String
  category     Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplierId   String?
  supplier     Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines        MaterialRequestLine[]
  // Set once a PO has been raised from this request (one PO per MR).
  purchaseOrder PurchaseOrder?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([projectId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([createdById])
  @@index([status])
  @@index([requestDate])
  @@map("material_request")
}

model MaterialRequestLine {
  id                String          @id @default(cuid())
  materialRequestId String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  // Sr No, 1-based and contiguous.
  lineNo            Int
  name              String
  unit              String
  quantity          Decimal         @db.Decimal(14, 2)
  remarks           String?

  @@unique([materialRequestId, lineNo])
  @@map("material_request_line")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ISSUED
  CLOSED
}

model PurchaseOrder {
  id                    String              @id @default(cuid())
  // Assigned from Settings > Document numbering when the order is created.
  number                String              @unique @db.Citext
  orderDate             DateTime            @db.Date
  status                PurchaseOrderStatus @default(DRAFT)
  // Source request, when the PO was raised from an approved MR.
  materialRequestId     String?             @unique
  materialRequest       MaterialRequest?    @relation(fields: [materialRequestId], references: [id], onDelete: Restrict)
  projectId             String
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // Shown as "Ordered by".
  departmentId          String
  department            Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  // Shown as the PO "Subject".
  categoryId            String
  category              Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  deliverTo             String
  // Supplier, plus the details as issued on this PO (editable, not live).
  supplierId            String
  supplier              Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName          String
  supplierAddress       String?
  supplierContactName   String?
  supplierContactNumber String?
  supplierEmail         String?
  supplierTelephone     String?
  supplierVat           String?
  quotationRef          String?
  // Amounts in `currency`, rounded to its minor units; computed on the server.
  currency              String
  subtotal              Decimal             @db.Decimal(18, 3)
  discount              Decimal             @default(0) @db.Decimal(18, 3)
  vatRate               Decimal             @db.Decimal(5, 2)
  vatAmount             Decimal             @db.Decimal(18, 3)
  total                 Decimal             @db.Decimal(18, 3)
  terms                 String?
  createdById           String
  createdBy             User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines                 PurchaseOrderLine[]
  paymentRequests       PaymentRequest[]
  goodsReceipts         GoodsReceipt[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([projectId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([createdById])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  // Sr No, 1-based and contiguous.
  lineNo          Int
  name            String
  unit            String
  quantity        Decimal       @db.Decimal(14, 2)
  unitPrice       Decimal       @db.Decimal(18, 3)
  total           Decimal       @db.Decimal(18, 3)
  receipts        GoodsReceiptLine[]

  @@unique([purchaseOrderId, lineNo])
  @@map("purchase_order_line")
}

enum PaymentRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum PaymentType {
  BANK_TRANSFER
  CHEQUE
  PETTY_CASH
}

enum PaymentPriority {
  NORMAL
  URGENT
  TOP_URGENT
}

model PaymentRequest {
  id              String               @id @default(cuid())
  // Assigned from Settings > Document numbering when the request is created.
  number          String               @unique @db.Citext
  requestDate     DateTime             @db.Date
  status          PaymentRequestStatus @default(DRAFT)
  // Source PO, if any. A PO can have several payment requests.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  projectId       String
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  supplierId      String?
  supplier        Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  inFavorOf       String
  description     String
  // Ticked expense items, e.g. "material.raw_material" (see lib/payment-request-options.ts).
  items           String[]
  otherDetails    String?
  paymentType     PaymentType
  priority        PaymentPriority
  currency        String
  amount          Decimal              @db.Decimal(18, 3)
  invoiceNo       String?
  quotationNo     String?
  createdById     String
  createdBy       User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([purchaseOrderId])
  @@index([projectId])
  @@index([supplierId])
  @@index([createdById])
  @@index([status])
  @@index([requestDate])
  @@map("payment_request")
}

enum GoodsReceiptStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum DeliveryMethod {
  AIR_FREIGHT
  LOCAL_DELIVERY
  PICK_UP
}

/// Goods Received Note. Raised from one PO; a PO can have several (partial deliveries).
model GoodsReceipt {
  id              String             @id @default(cuid())
  // Assigned from Settings > Document numbering when the GRN is created.
  number          String             @unique @db.Citext
  receiptDate     DateTime           @db.Date
  status          GoodsReceiptStatus @default(DRAFT)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  // Copied from the PO when the GRN is created.
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // "Ordered by".
  departmentId    String
  department      Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  // "From" (editable copy of the PO's supplier details).
  supplierName    String
  supplierAddress String?
  invoiceNo       String?
  deliveredBy     DeliveryMethod
  remarks         String?
  createdById     String
  createdBy       User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines           GoodsReceiptLine[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([purchaseOrderId])
  @@index([projectId])
  @@index([departmentId])
  @@index([createdById])
  @@index([status])
  @@index([receiptDate])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  // Sr No, 1-based and contiguous.
  lineNo              Int
  itemCode            String?
  // Copied from the PO line.
  description         String
  unit                String
  departmentId        String
  department          Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  // Quantities; outstanding/short/excess/accepted are computed on the server.
  orderedQty          Decimal           @db.Decimal(14, 2)
  // Ordered minus quantities accepted on earlier (non-rejected) GRNs, at save time.
  outstandingQty      Decimal           @db.Decimal(14, 2)
  receivedQty         Decimal           @db.Decimal(14, 2)
  shortQty            Decimal           @db.Decimal(14, 2)
  excessQty           Decimal           @db.Decimal(14, 2)
  rejectedQty         Decimal           @db.Decimal(14, 2)
  acceptedQty         Decimal           @db.Decimal(14, 2)

  @@unique([goodsReceiptId, lineNo])
  @@index([purchaseOrderLineId])
  @@index([departmentId])
  @@map("goods_receipt_line")
}

// ---------------------------------------------------------------------------
// Audit log (Super Admin only). Append-only: a database trigger rejects any
// UPDATE or DELETE (see migration 20261103120000_audit_log). No foreign keys,
// so entries survive whatever happens to the records they describe.
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  // Who acted (copied at the time). Null actor = system or unknown user.
  actorId     String?
  actorName   String?
  actorEmail  String?
  // e.g. "create", "update", "delete", "status", "sign_in", "sign_in_failed".
  action      String
  // e.g. "purchase_order", "user", "settings", "auth".
  entityType  String
  entityId    String?
  // Human-readable record name at the time, e.g. "PO-2026-0003".
  entityLabel String?
  summary     String
  // [{ field, label, from, to }] for field-level changes.
  changes     Json?
  ipAddress   String?
  userAgent   String?

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@map("audit_log")
}
