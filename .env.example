# Copy to .env and fill in real values. Never commit .env.

# Neon pooled connection string (host contains "-pooler"). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct (unpooled) connection string. Used by Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# At least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""

# Public base URL of the app.
BETTER_AUTH_URL="http://localhost:3000"

# Super Admin account. After changing these, run: npm run sync-super-admin
# Password: at least 12 characters.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_NAME=""
SUPER_ADMIN_PASSWORD=""
