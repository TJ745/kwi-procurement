generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth core tables)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // Built-in system role: "super_admin" (the .env-managed account, full
  // access) or "user" (access defined by `customRole`). Never accepted from
  // client input (see lib/auth.ts).
  role               String    @default("user")
  roleId             String?
  customRole         Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  // Deactivated users cannot sign in; records are kept for history.
  active             Boolean   @default(true)
  // Set when an administrator assigns a temporary password.
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  sessions           Session[]
  accounts           Account[]
  materialRequests   MaterialRequest[]
  notifications      Notification[]

  @@index([roleId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Access control and settings
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique @db.Citext
  description String?
  // Permission keys such as "projects:view" (see lib/permissions.ts).
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("role")
}

// Single row (id = 1) holding system-wide settings.
model AppSettings {
  id                   Int      @id @default(1)
  companyName          String?
  companyAddress       String?
  companyVat           String?
  companyCr            String?
  companyPhone         String?
  companyEmail         String?
  companyLogo          Bytes?
  companyLogoType      String?
  currency             String   @default("USD")
  timeZone             String   @default("UTC")
  dateFormat           String   @default("d MMM yyyy")
  sessionDurationHours Int      @default(168)
  minPasswordLength    Int      @default(12)
  updatedAt            DateTime @updatedAt

  @@map("app_settings")
}

// Numbering configuration and counter per document type.
model DocumentSequence {
  type        String   @id
  prefix      String
  includeYear Boolean  @default(true)
  resetYearly Boolean  @default(true)
  padding     Int      @default(4)
  nextNumber  Int      @default(1)
  // Year the counter last started from 1 (used when resetYearly is on).
  counterYear Int?
  updatedAt   DateTime @updatedAt

  @@map("document_sequence")
}

// In-app notifications shown in the header bell.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // e.g. "material_request.created" (see lib/notifications.ts).
  type      String
  title     String
  body      String
  // In-app path the notification opens, e.g. /material-requests/abc.
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Master data
// Citext columns make uniqueness case-insensitive (requires the citext
// extension, created in migration 20261101120000_master_data_constraints).
// ---------------------------------------------------------------------------

model Project {
  id        String   @id @default(cuid())
  code      String   @unique @db.Citext
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  materialRequests MaterialRequest[]

  @@map("project")
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  // Stored normalised (uppercase, no spaces); unique when provided.
  vat           String?  @unique
  cr            String?
  iban          String?
  address       String?
  contactName   String?
  contactEmail  String?
  contactNumber String?
  email         String?
  telephone     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  materialRequests MaterialRequest[]

  @@map("supplier")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique @db.Citext
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  materialRequests MaterialRequest[]

  @@map("department")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique @db.Citext
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  materialRequests MaterialRequest[]

  @@map("category")
}

// ---------------------------------------------------------------------------
// Procurement workflows
// ---------------------------------------------------------------------------

enum MaterialRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model MaterialRequest {
  id           String                @id @default(cuid())
  // Assigned from Settings > Document numbering when the request is created.
  number       String                @unique @db.Citext
  requestDate  DateTime              @db.Date
  status       MaterialRequestStatus @default(DRAFT)
  projectId    String
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // Shown as "Requested by".
  departmentId String
  department   Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  categoryId   String
  category     Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplierId   String?
  supplier     Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines        MaterialRequestLine[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([projectId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([createdById])
  @@index([status])
  @@index([requestDate])
  @@map("material_request")
}

model MaterialRequestLine {
  id                String          @id @default(cuid())
  materialRequestId String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  // Sr No, 1-based and contiguous.
  lineNo            Int
  name              String
  unit              String
  quantity          Decimal         @db.Decimal(14, 2)
  remarks           String?

  @@unique([materialRequestId, lineNo])
  @@map("material_request_line")
}
